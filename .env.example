# Copy to .env and fill in values
# Frontend dev server port
VITE_PORT=3000

# Your Python backend base URL (server on port 8000)
VITE_API_URL=http://localhost:8000

# Optional: LiveKit connection details endpoint
# VITE_CONN_DETAILS_ENDPOINT=

# Optional: App config endpoint
# VITE_APP_CONFIG_ENDPOINT=

# Optional: LiveKit Cloud Sandbox
# VITE_SANDBOX_ID=
# VITE_APP_URL=
